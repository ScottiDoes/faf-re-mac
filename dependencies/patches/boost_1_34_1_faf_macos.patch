diff --git a/libs/thread/src/mutex.cpp b/libs/thread/src/mutex.cpp
index bb73b9c..acbba08 100644
--- a/libs/thread/src/mutex.cpp
+++ b/libs/thread/src/mutex.cpp
@@ -191,10 +191,38 @@ void timed_mutex::do_unlock(cv_state&)
 
 #elif defined(BOOST_HAS_PTHREADS)
 
+#if defined(FAF_POSIX)
+// FAF macOS port: on Windows, boost::mutex and boost::try_mutex are critical sections
+// (new_critical_section above), which the owning thread may enter again. The engine relies
+// on that: e.g. Moho::STAT_GetLuaTable holds a StatItem's lock and calls StatItem::GetString,
+// which takes the same lock. A default pthread mutex deadlocks there, so the POSIX build
+// gives these two the Windows semantics with a recursive pthread mutex. boost::condition
+// waits work as before (the engine never waits with the lock held more than once, which
+// would deadlock on Windows too).
+namespace {
+int faf_init_windows_like_mutex(pthread_mutex_t* m)
+{
+    pthread_mutexattr_t attr;
+    int res = pthread_mutexattr_init(&attr);
+    if (res != 0)
+        return res;
+    res = pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+    if (res == 0)
+        res = pthread_mutex_init(m, &attr);
+    pthread_mutexattr_destroy(&attr);
+    return res;
+}
+} // namespace
+#endif
+
 mutex::mutex()
 {
     int res = 0;
+#if defined(FAF_POSIX)
+    res = faf_init_windows_like_mutex(&m_mutex);
+#else
     res = pthread_mutex_init(&m_mutex, 0);
+#endif
     if (res != 0)
         throw thread_resource_error();
 }
@@ -234,7 +262,11 @@ void mutex::do_unlock(cv_state& state)
 try_mutex::try_mutex()
 {
     int res = 0;
+#if defined(FAF_POSIX)
+    res = faf_init_windows_like_mutex(&m_mutex);
+#else
     res = pthread_mutex_init(&m_mutex, 0);
+#endif
     if (res != 0)
         throw thread_resource_error();
 }
