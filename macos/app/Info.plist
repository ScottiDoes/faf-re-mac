<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FAF Native.app, the setup and status window (macos/app/setup; make_app.sh fills in the @...@
     fields). The game is the nested app Contents/Helpers/FAF Native Game.app (Game-Info.plist). -->
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>FAF Native</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleName</key>
	<string>FAF Native</string>
	<key>CFBundleDisplayName</key>
	<string>FAF Native</string>
	<key>CFBundleIconFile</key>
	<string>FAFNative.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>FAFNativeVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSArchitecturePriority</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.strategy-games</string>
</dict>
</plist>
